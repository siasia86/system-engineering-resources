#!/bin/bash
# ============================================
# pre-push hook - 신규 커밋 민감정보 검사
# ============================================

set -euo pipefail

if ! command -v gitleaks &> /dev/null; then
    echo ""
    echo "⚠️  gitleaks가 설치되지 않았습니다."
    echo "설치 방법:"
    echo "  - 공식 릴리스: https://github.com/gitleaks/gitleaks/releases"
    echo "  - macOS: brew install gitleaks"
    echo ""
    exit 1
fi

# stdin에서 push 대상 정보 읽기
# 형식: <local_ref> <local_sha> <remote_ref> <remote_sha>
# local_ref와 remote_ref도 Git의 표준 4필드 형식을 유지하기 위해 읽습니다.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
    # 브랜치 삭제 push는 스킵
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # 신규 브랜치 → 원격 추적 브랜치에 없는 전체 커밋을 스캔
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # --not --remotes는 기존 원격 추적 브랜치의 커밋을 제외합니다.
        # 원격 추적 브랜치가 없으면 local_sha부터 전체 이력을 검사합니다.
        LOG_OPTS="${local_sha} --not --remotes"
    else
        LOG_OPTS="${remote_sha}..${local_sha}"
    fi

    if ! gitleaks git --redact -v --log-opts "$LOG_OPTS"; then
        echo ""
        echo "❌ 민감정보가 탐지되어 push가 차단되었습니다."
        echo "위 내용을 확인하고 민감정보를 제거한 후 다시 push하세요."
        exit 1
    fi
done

echo "✅ gitleaks 검사 통과"
exit 0
