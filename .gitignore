# Consumer .gitignore template
# 31 owns the common block; the consumer owns the local block.

# BEGIN 31 COMMON
# Governance sync artifacts
.kiro-lock
.governance-sync.lock
.governance/.governance-sync-state.json
.governance/.sync-snapshots/
# Private local evidence and before/after backups
.governance/local/

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.AppleDouble
*.swp
*.swo
*~
.vscode/
.idea/

# Credentials, keys, and cloud configuration
**/.ssh/id_*
**/.ssh/*_id_*
**/.ssh/known_hosts
*.pem
*.ppk
*.key
.aws/
*.awsconfig
*.awsjson
.git/credentials

# Terraform state and sensitive variables
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
*.tfvars
*.tfvars.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc

# Local, secret, temporary, and generated files
*.local
.env
.env.*
!.env.example
*.log
crash.log
crash.*.log
*.tmp
*.bak
*.pyc
__pycache__/
.pytest_cache/
.venv/

# Claude Code session worktrees
/.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md
/.codex/local/
AGENTS.override.md
# END 31 COMMON

# BEGIN CONSUMER LOCAL
# Reviewed repository-specific candidate rules.
/.staging/

# 32 현장 패턴 (31 COMMON에 없는 항목만 유지)
# OS·편집기
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*.sublime-project
*.sublime-workspace

# 임시·백업
*.cache
*.backup
*.old
*.bak_*

# 개인 메모 (공유하지 않음)
*_private.md
*_personal.md
notes/
.local/

# 중복 자료
*masang*
*masang*.md

# 마스킹 도구 매핑 (json_mask.py, ip_mask.py)
*.map.json
*.map.json*
*.map.ip.json
*.map.ip.json*

# 원문 자료 제외 — 법령 원문은 비공개 저장소 37_law, 개인정보 등 민감 자료는
# system-engineering-resources_private에 보관합니다. 이 저장소에는 해설과 출처 주소만 둡니다.
06_career/legal/_reference/*.pdf
06_career/legal/_reference/*.hwp
06_career/legal/_reference/*.hwpx
# END CONSUMER LOCAL
